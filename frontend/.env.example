# Public client config only. Never put a client secret here.
NEXT_PUBLIC_API_URL=https://collab-docs-api.<your-worker-subdomain>.workers.dev
NEXT_PUBLIC_OIDC_AUTHORIZATION_URL=https://identity.example.com/oauth2/authorize
NEXT_PUBLIC_OIDC_TOKEN_URL=https://identity.example.com/oauth2/token
NEXT_PUBLIC_OIDC_CLIENT_ID=replace-with-public-client-id
NEXT_PUBLIC_OIDC_REDIRECT_URI=https://collab-docs-4tb.pages.dev/
NEXT_PUBLIC_OIDC_SCOPES=openid profile email
NEXT_PUBLIC_OIDC_AUDIENCE=replace-with-api-audience
NEXT_PUBLIC_SENTRY_DSN=
