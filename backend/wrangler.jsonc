{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "collab-docs-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-13",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true, "head_sampling_rate": 1 },
  "vars": {
    "ENVIRONMENT": "development",
    "FRONTEND_ORIGIN": "http://localhost:3000",
    "AUTH_MODE": "demo",
    "APP_VERSION": "0.1.0"
  },
  "durable_objects": {
    "bindings": [{ "name": "DOC_ROOMS", "class_name": "DocumentRoom" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["DocumentRoom"] }],
  "d1_databases": [{
    "binding": "DB",
    "database_name": "collab-docs-db",
    "database_id": "REPLACE_WITH_D1_DATABASE_ID",
    "migrations_dir": "migrations"
  }],
  "kv_namespaces": [{ "binding": "SESSIONS", "id": "REPLACE_WITH_KV_NAMESPACE_ID" }],
  "r2_buckets": [{ "binding": "SNAPSHOTS", "bucket_name": "collab-docs-snapshots" }],
  "queues": {
    "producers": [{ "binding": "DOCUMENT_EVENTS", "queue": "document-events" }],
    "consumers": [{
      "queue": "document-events",
      "max_batch_size": 25,
      "max_batch_timeout": 5,
      "max_retries": 3,
      "dead_letter_queue": "document-events-dlq"
    }]
  }
}
